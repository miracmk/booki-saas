{
  "intelephense.files.exclude": [
    "**/.git/**",
    "**/.svn/**",
    "**/.hg/**",
    "**/CVS/**",
    "**/.DS_Store/**",
    "**/node_modules/**",
    "**/vendor/**/{Test,test,Tests,tests}/**",
    "**/storage/logs/**",
    "**/data/files/logs/**",
    "**/application/logs/**",
    "**/system/libraries/Xmlrpc*.php"
  ],
  "intelephense.diagnostics.undefinedTypes": false,
  "files.watcherExclude": {
    "**/storage/logs/**": true,
    "**/data/files/logs/**": true,
    "**/application/logs/**": true
  },
  "search.exclude": {
    "**/storage/logs": true,
    "**/data/files/logs": true
  }
}
